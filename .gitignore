# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Full book PDFs: private. Only rendered preview pages (public/previews/) are served.
/content/books/*.pdf

# API server (deployed separately to Render)
/server/node_modules
/server/dist

# Local credential files (never commit)
*.env
*credentials*

# Admin app (deployed separately to admin.ezhupira.in)
/admin/node_modules
/admin/.next
/admin/next-env.d.ts
