# Website (Next.js). Copy to .env.local for local dev; set the same in Vercel → Settings → Environment Variables.

# The API server (server/). Optional: defaults to https://api.ezhupira.in in production builds
# and http://localhost:4000 in development. Set it only to use a different API.
NEXT_PUBLIC_API_URL=

# Optional: Bing Webmaster Tools verification token
NEXT_PUBLIC_BING_SITE_VERIFICATION=
