# Copy to .env for local development (pnpm dev). On Render, set these in the dashboard.

NODE_ENV=development
PORT=4000

# The website and this API
SITE_URL=http://localhost:3000
PUBLIC_URL=http://localhost:4000
# Production: SITE_URL=https://ezhupira.in  PUBLIC_URL=https://api.ezhupira.in  COOKIE_DOMAIN=.ezhupira.in
COOKIE_DOMAIN=
# Comma-separated extra origins allowed to call the API: the admin app, Vercel previews.
# Production: https://admin.ezhupira.in   Local: http://localhost:3002
EXTRA_ORIGINS=http://localhost:3002

# MongoDB Atlas connection string (Mumbai region recommended)
# Local Windows dev only, if SRV lookups fail with ECONNREFUSED: DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ezhupira?retryWrites=true&w=majority

# Firebase console → Project settings → General → Project ID
FIREBASE_PROJECT_ID=ezhupira
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Your Google account email(s); these become admins on sign-in
ADMIN_EMAILS=

# Cashfree dashboard → Developers → API keys (use sandbox keys until KYC is approved)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01

# Resend → API Keys; verify ezhupira.in under Domains first
RESEND_API_KEY=
MAIL_FROM=Ezhupira <orders@ezhupira.in>
MAIL_ADMIN=

# Shared with the website (Vercel) so admin book edits refresh the site at once. Optional:
# without it the site picks up changes within 60 seconds.
REVALIDATE_SECRET=

# Self-ping /health every N minutes in production so Render's free tier doesn't sleep (0 = off)
KEEP_ALIVE_MINUTES=10
